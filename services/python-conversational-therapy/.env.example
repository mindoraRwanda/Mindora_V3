MINDORA_INTEGRATION_KEY=REPLACE_WITH_THE_SAME_HIGH_ENTROPY_SECRET_USED_BY_V3
# Copy this file to .env for local development. Never commit the real .env.
APP_ENV=development
CHATBOT_CREATE_TABLES_ON_STARTUP=true

# Local Compose PostgreSQL. Use a long, random, URL-safe password.
POSTGRES_USER=mindora_chatbot
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=mindora_chatbot
DATABASE_URL=
CHATBOT_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CHATBOT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend origin(s), comma-separated.
CHATBOT_CORS_ORIGINS=https://app.mindora.rw

# Model and retrieval services. Adjust hostnames for your deployment.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=therapy_knowledge_base
QDRANT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Private service-to-service crisis event forwarding to MINDORA V3.
# Leave unset in isolated local development. For staging, use the internal
# V3 gateway URL and the same high-entropy token configured in V3 secrets.
MINDORA_CRISIS_WEBHOOK_URL=
MINDORA_CRISIS_WEBHOOK_TOKEN=

# Clinical resources must remain disabled until MINDORA written approval.
CRISIS_CONTACTS_APPROVED=false
CRISIS_APPROVED_RESOURCES=
CRISIS_APPROVED_THERAPIST_ROUTE=
