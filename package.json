{
  "name": "mindora_v3",
  "version": "1.0.0",
  "private": true,
  "description": "Mindora V3 monorepo — mental health platform microservices",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=10",
    "dev:messaging": "turbo run dev --filter=@mindora/messaging-service --filter=@mindora/auth-service",
    "dev:community": "turbo run dev --filter=@mindora/community-service --filter=@mindora/auth-service",
    "dev:auth": "turbo run dev --filter=@mindora/auth-service",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "db:generate": "npm run generate -w @mindora/database",
    "db:migrate": "npm run migrate:dev -w @mindora/database",
    "db:seed": "npm run seed -w @mindora/database",
    "db:seed:profiles": "npm run seed -w @mindora/user-service",
    "db:seed:appointments": "npm run seed -w @mindora/appointment-service",
    "db:seed:mood": "npm run seed -w @mindora/mood-tracking-service",
    "db:seed:community": "npm run seed -w @mindora/community-service",
    "postinstall": "node -e \"const{rmSync,existsSync}=require('fs');const p='node_modules/africastalking/node_modules/axios';if(existsSync(p))rmSync(p,{recursive:true,force:true});\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindoraRwanda/Mindora_V3.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.2.0",
    "better-npm-audit": "^3.11.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.26.1",
    "vitest": "^4.1.8"
  },
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "axios": "^1.18.1",
    "joi": "^18.2.3",
    "africastalking": {
      "axios": "^1.18.1",
      "joi": "^18.2.3"
    },
    "vite": "7.3.6"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "mongoose": "^9.6.3",
    "resend": "^6.16.0",
    "socket.io": "^4.8.3"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
