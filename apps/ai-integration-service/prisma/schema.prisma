generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("AI_DATABASE_URL")
}

model AiInteraction {
  id             String   @id @default(uuid())
  user_id        String
  session_id     String
  // AES-256-GCM encryption is applied at the application layer before writing this field
  user_message   String
  // AES-256-GCM encryption is applied at the application layer before writing this field
  ai_response    String
  input_flagged  Boolean  @default(false)
  output_flagged Boolean  @default(false)
  // DB-level CHECK constraint: crisis_level >= 0 AND crisis_level <= 5
  // (see migration 20260706000000_crisis_level_check)
  // Prisma 6 does not expose @@check in the schema language; constraint is enforced by PostgreSQL directly.
  crisis_level   Int      @db.SmallInt
  tokens_used    Int?
  response_ms    Int?
  created_at     DateTime @default(now()) @db.Timestamptz

  @@map("ai_interactions")
}

// Durable record of a crisis detection, written to this service's own
// database before the user is answered.
//
// Previously a Level 5 disclosure existed only as a fire-and-forget RabbitMQ
// publish: the route returned before writing any ai_interactions row, so if
// the broker was briefly down there was no record anywhere that a user had
// disclosed an active plan. This table is the source of truth; the RabbitMQ
// publish (which populates the clinician queue in Admin Service) is treated
// as delivery of that record and retried until it succeeds.
model CrisisAlert {
  id           String    @id @default(uuid())
  user_id      String
  session_id   String?
  crisis_level Int       @db.SmallInt
  detected_at  DateTime  @default(now()) @db.Timestamptz
  // Delivery bookkeeping for the outbox sweeper.
  published    Boolean   @default(false)
  published_at DateTime? @db.Timestamptz
  attempts     Int       @default(0)
  last_error   String?

  // Sweeper scans for undelivered rows oldest-first.
  @@index([published, detected_at])
  @@index([user_id])
  @@map("crisis_alerts")
}

// Links a Mindora patient to their account on the external Therapy Chatbot
// API (a separate service with its own signup/login and conversation
// history — see src/chatbotClient.ts). One row per patient; the chatbot
// account's credentials are provisioned lazily on that patient's first chat.
model ChatbotAccount {
  id               String    @id @default(uuid())
  mindora_user_id  String    @unique
  chatbot_user_id  String
  chatbot_email    String
  // AES-256-GCM encryption is applied at the application layer before writing
  // this field, and access_token below — both are live credentials for that
  // patient's chat account. Read them back through decrypt() in
  // src/chatbotClient.ts, never directly.
  chatbot_password String
  access_token     String?
  token_expires_at DateTime? @db.Timestamptz
  conversation_id  String?
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz

  @@map("chatbot_accounts")
}
