generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("AI_DATABASE_URL")
}

model AiInteraction {
  id             String   @id @default(uuid())
  user_id        String
  session_id     String
  // AES-256-GCM encryption is applied at the application layer before writing this field
  user_message   String
  // AES-256-GCM encryption is applied at the application layer before writing this field
  ai_response    String
  input_flagged  Boolean  @default(false)
  output_flagged Boolean  @default(false)
  // DB-level CHECK constraint: crisis_level >= 0 AND crisis_level <= 5
  // (see migration 20260706000000_crisis_level_check)
  // Prisma 6 does not expose @@check in the schema language; constraint is enforced by PostgreSQL directly.
  crisis_level   Int      @db.SmallInt
  tokens_used    Int?
  response_ms    Int?
  created_at     DateTime @default(now()) @db.Timestamptz

  @@map("ai_interactions")
}

// Links a Mindora patient to their account on the external Therapy Chatbot
// API (a separate service with its own signup/login and conversation
// history — see src/chatbotClient.ts). One row per patient; the chatbot
// account's credentials are provisioned lazily on that patient's first chat.
model ChatbotAccount {
  id               String    @id @default(uuid())
  mindora_user_id  String    @unique
  chatbot_user_id  String
  chatbot_email    String
  // AES-256-GCM encryption is applied at the application layer before writing this field
  chatbot_password String
  access_token     String?
  token_expires_at DateTime? @db.Timestamptz
  conversation_id  String?
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz

  @@map("chatbot_accounts")
}
