generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("MOOD_DATABASE_URL")
}

// mood_entries is a TimescaleDB hypertable partitioned by recorded_at
// Run after migration: SELECT create_hypertable('mood_entries', 'recorded_at');
model MoodEntry {
  id                   String   @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  moodScore            Int      @map("mood_score")
  emotions             String[] @default([])
  sleepHours           Float?   @map("sleep_hours")
  stressLevel          Int?     @map("stress_level")
  energyLevel          Int?     @map("energy_level")
  journalNoteEncrypted String?  @map("journal_note_encrypted")
  triggers             String[] @default([])
  recordedAt           DateTime @default(now()) @map("recorded_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@id([id, recordedAt])
  @@index([userId, recordedAt])
  @@map("mood_entries")
}

// Durable outbox for mood.concern and mood.streak events — mirrors the
// crisis-alert pattern in ai-integration-service's CrisisAlert model.
// RabbitMQ being briefly down must never lose one of these silently: the
// row is written first, publishing is best-effort from the request path,
// and the sweeper in lib/pending-mood-events.ts retries anything left
// undelivered.
model PendingMoodEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  // Sweeper scans for undelivered rows oldest-first.
  @@index([published, createdAt])
  @@map("pending_mood_events")
}
