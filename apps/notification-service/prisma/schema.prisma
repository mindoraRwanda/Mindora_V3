generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("NOTIFICATION_DATABASE_URL")
}

model notification_logs {
  id            String    @id @default(uuid())
  userId        String
  eventType     String
  channel       String // "push" | "email" | "sms"
  status        String // "delivered" | "failed" | "skipped"
  attempts      Int       @default(1)
  deliveredAt   DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())
  // Set when the user opens/dismisses this notification in-app (GET/PUT
  // /api/v1/notifications). Nullable = unread; this is the same row the
  // admin-only delivery log already reads (GET /api/v1/notifications/logs)
  // — one table serving both views, not a second notifications system.
  readAt        DateTime?

  @@index([userId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@index([userId, readAt])
}
