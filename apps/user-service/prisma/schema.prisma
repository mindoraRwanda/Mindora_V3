generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_DATABASE_URL")
}

// Copied from packages/database/prisma/schema.prisma. userId is a plain
// identifier — no @relation, no foreign key. User Service looks up user
// data via Auth Service's internal API, not through a Prisma join; the
// User model lives in Auth Service's isolated 'mindora_auth' database now.
model PatientProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  userName                String?  @map("user_name")
  bio                     String?
  timezone                String   @default("UTC")
  languagePreference      String   @default("en") @map("language_preference")
  fcmToken                String?  @map("fcm_token")
  notificationPreferences Json     @default("{\"push\": true, \"email\": true, \"sms\": true}") @map("notification_preferences")
  // Denormalized copies from Auth Service's users table (role, email),
  // populated at profile creation via the user.registered event. Nullable —
  // existing rows predate this and are backfilled separately, not via a
  // migration default. Not a source of truth; Auth Service's
  // GET /internal/auth/users/:id is the authoritative source if these ever
  // need to be refreshed.
  role                    String?
  email                   String?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("patient_profiles")
}

model TherapistProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  userName                String?  @map("user_name")
  bio                     String?
  timezone                String   @default("UTC")
  languagePreference      String   @default("en") @map("language_preference")
  specialisation          String?
  languages               String[] @default([])
  isAcceptingPatients     Boolean  @default(true) @map("is_accepting_patients")
  photoUrl                String?  @map("photo_url")
  fcmToken                String?  @map("fcm_token")
  notificationPreferences Json     @default("{\"push\": true, \"email\": true, \"sms\": true}") @map("notification_preferences")
  // Denormalized copies from Auth Service's users table (role, email),
  // populated at profile creation via the user.registered event. Nullable —
  // existing rows predate this and are backfilled separately, not via a
  // migration default. Not a source of truth; Auth Service's
  // GET /internal/auth/users/:id is the authoritative source if these ever
  // need to be refreshed.
  role                    String?
  email                   String?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Denormalized from TherapistApplication for GET /therapists filtering
  // only — nullable because rows seeded/created before the application
  // system existed predate this (seed.ts stamps them APPROVED directly).
  // The application/status-transition endpoints are the source of truth;
  // never write these two fields from anywhere else.
  applicationStatus TherapistApplicationStatus? @map("application_status")
  applicationId     String?                     @db.Uuid @map("application_id")
  // Distinct from Auth Service's account-level suspension (isActive):
  // that revokes all API access; this only hides the therapist from patient
  // discovery. Admin-service's therapist-suspend route sets both, in that
  // order, so a failed auth-service call never leaves a therapist hidden
  // from search but still fully able to use a live token.
  isSuspended       Boolean                     @default(false) @map("is_suspended")

  @@index([isAcceptingPatients])
  @@index([specialisation])
  @@index([applicationStatus])
  @@index([isSuspended])
  @@map("therapist_profiles")
}

enum TherapistApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFORMATION_REQUIRED
}

// A prospective therapist's onboarding application. userId is a plain
// identifier, no @relation — same cross-service convention as
// PatientProfile/TherapistProfile.userId above; the account itself lives in
// Auth Service. A user keeps role PATIENT through the entire review; role
// only flips to THERAPIST when this application is APPROVED (see
// user.routes.ts's status-transition handler and auth.routes.ts's
// PATCH /internal/auth/users/:id).
model TherapistApplication {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  status TherapistApplicationStatus @default(DRAFT)

  fullName     String @map("full_name")
  phoneNumber  String @map("phone_number")
  contactEmail String @map("contact_email")

  professionalBio                String    @map("professional_bio")
  qualifications                  String[]  @default([])
  certifications                  String[]  @default([])
  licenseNumber                   String    @map("license_number")
  licenseIssuingBody              String    @map("license_issuing_body")
  licenseExpiryDate               DateTime? @map("license_expiry_date")
  professionalRegistrationNumber  String?   @map("professional_registration_number")
  specialisations                 String[]  @default([])
  yearsOfExperience               Int       @map("years_of_experience")
  languages                       String[]  @default([])

  // Free text at intake, not a real schedule — the therapist configures
  // real availability in appointment-service after approval, this is only
  // context for the reviewer.
  availabilitySummary String? @map("availability_summary")
  location            String
  timezone            String  @default("Africa/Kigali")

  submittedAt DateTime? @map("submitted_at")
  reviewedAt  DateTime? @map("reviewed_at")
  // The admin's Auth Service userId — plain field, not a local FK, same
  // convention as userId above.
  reviewedBy  String?   @db.Uuid @map("reviewed_by")
  // Applicant-visible record of the last REJECTED/MORE_INFORMATION_REQUIRED
  // decision. Without these, the reason/note only ever reached the
  // applicant via the one-off notification email (see notification-service)
  // — anyone who missed that email, or just revisits the application page
  // later, had no way to see why. Whichever is relevant to the current
  // `status` is the one to show; the other is simply stale from a prior
  // decision, not cleared on later transitions.
  rejectionReason String? @map("rejection_reason")
  infoRequestNote String? @map("info_request_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents TherapistDocument[]
  notes     TherapistApplicationNote[]

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@map("therapist_applications")
}

model TherapistDocument {
  id            String               @id @default(uuid()) @db.Uuid
  applicationId String               @map("application_id") @db.Uuid
  application   TherapistApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // LICENSE | CERTIFICATION | ID | OTHER — plain string, not an enum, kept
  // loose since new document categories shouldn't need a migration.
  documentType String   @map("document_type")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  // Object-store key only — never a public URL. Retrieval is always a
  // short-TTL presigned GET generated per request; see object-storage.ts.
  storageKey   String   @map("storage_key")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  @@index([applicationId])
  @@map("therapist_documents")
}

// Internal reviewer commentary on an application — distinct from
// admin-service's immutable audit_logs (that's the action record: who
// approved/rejected/requested-info and when). This is free-form notes
// admins leave for each other, visible only within the admin review UI.
model TherapistApplicationNote {
  id            String               @id @default(uuid()) @db.Uuid
  applicationId String               @map("application_id") @db.Uuid
  application   TherapistApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // The admin's Auth Service userId — plain field, not a local FK.
  authorId      String               @map("author_id") @db.Uuid
  note          String
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([applicationId])
  @@map("therapist_application_notes")
}


enum TherapistCarePlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Only goal-setting content is stored here. The payload (including title,
// goals and milestone labels) is encrypted with a dedicated application key.
// Patient and therapist ids are identifiers only; the relationship is
// validated through Appointment Service before therapist access is granted.
model TherapistCarePlan {
  id                    String                 @id @default(uuid()) @db.Uuid
  therapistId           String                 @map("therapist_id") @db.Uuid
  patientId             String                 @map("patient_id") @db.Uuid
  encryptedPayload      String                 @map("encrypted_payload")
  status                TherapistCarePlanStatus @default(DRAFT)
  patientAcknowledgedAt DateTime?              @map("patient_acknowledged_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([therapistId, status, updatedAt])
  @@index([patientId, status])
  @@map("therapist_care_plans")
}

// Prescription draft records are not prescriptions. The encrypted payload is
// only a working draft and no model status can represent issue, signing,
// dispensing or pharmacy transmission. Therapist/patient IDs are identifiers
// only; access is checked through Appointment Service before every operation.
enum PrescriptionDraftStatus {
  DRAFT
  ARCHIVED
}

model TherapistPrescriptionDraft {
  id               String                 @id @default(uuid()) @db.Uuid
  therapistId      String                 @map("therapist_id") @db.Uuid
  patientId        String                 @map("patient_id") @db.Uuid
  encryptedPayload String                 @map("encrypted_payload")
  status           PrescriptionDraftStatus @default(DRAFT)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([therapistId, status, updatedAt])
  @@index([patientId, status])
  @@map("therapist_prescription_drafts")
}

// Medication changes are patient-submitted requests for therapist review.
// They do not mutate a medicine list or automatically change a clinical
// record. Both request and review notes are stored only inside encryptedPayload.
enum MedicationUpdateStatus {
  PENDING
  REVIEWED
  FOLLOW_UP_REQUIRED
}

model MedicationUpdateRequest {
  id               String                @id @default(uuid()) @db.Uuid
  therapistId      String                @map("therapist_id") @db.Uuid
  patientId        String                @map("patient_id") @db.Uuid
  encryptedPayload String                @map("encrypted_payload")
  status           MedicationUpdateStatus @default(PENDING)
  reviewedAt       DateTime?             @map("reviewed_at")
  reviewedBy       String?               @db.Uuid @map("reviewed_by")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([therapistId, status, createdAt])
  @@index([patientId, createdAt])
  @@map("medication_update_requests")
}

// Append-only operational audit of clinical-workspace writes. Payloads are
// deliberately excluded: audit metadata records action/state only, never
// medication instructions, notes, strengths or other plaintext clinical data.
model ClinicalWorkspaceAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  recordType String   @map("record_type")
  recordId   String   @map("record_id") @db.Uuid
  actionType String   @map("action_type")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([recordType, recordId])
  @@map("clinical_workspace_audit_logs")
}

