generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("ADMIN_DATABASE_URL")
}

// Immutable audit log — NO update or delete routes ever.
// Every admin action must create an entry here.
model audit_logs {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  actionType String   @map("action_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([actionType])
  @@index([createdAt])
  @@map("audit_logs")
}

model moderation_decisions {
  id       String   @id @default(uuid())
  reportId String   @map("report_id")
  adminId  String   @map("admin_id")
  decision String // "REMOVED" | "DISMISSED"
  reason   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@index([adminId])
  @@map("moderation_decisions")
}

model system_alerts {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")
  severity  String // "HIGH" | "MEDIUM" | "LOW"
  payload   Json
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@map("system_alerts")
}
