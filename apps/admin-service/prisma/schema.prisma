generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("ADMIN_DATABASE_URL")
}

// Immutable audit log — NO update or delete routes ever.
// Every admin action must create an entry here.
model audit_logs {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  actionType String   @map("action_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([actionType])
  @@index([createdAt])
  @@map("audit_logs")
}

model moderation_decisions {
  id       String   @id @default(uuid())
  reportId String   @map("report_id")
  adminId  String   @map("admin_id")
  decision String // "REMOVED" | "DISMISSED"
  reason   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@index([adminId])
  @@map("moderation_decisions")
}

model system_alerts {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")
  severity  String // "HIGH" | "MEDIUM" | "LOW"
  payload   Json
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Acknowledgement is distinct from resolution: acknowledged means a named
  // clinician has SEEN it, resolved means the situation was dealt with. The
  // gap between raised and acknowledged is the number that matters for a
  // crisis alert, and without recording it there is no way to tell an alert
  // nobody has looked at from one that is merely still open.
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by")

  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  // Supports the queue's default view: unacknowledged, oldest first.
  @@index([acknowledgedAt, createdAt])
  @@map("system_alerts")
}
