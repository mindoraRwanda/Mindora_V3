generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  THERAPIST
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SessionType {
  VIDEO
  IN_PERSON
  CHAT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  googleId     String?  @unique @map("google_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens        RefreshToken[]
  patientProfile       PatientProfile?
  therapistProfile     TherapistProfile?
  patientAppointments  Appointment[] @relation("PatientAppointments")
  therapistAppointments Appointment[] @relation("TherapistAppointments")
  moodEntries          MoodEntry[]

  @@map("users")
}

model RefreshToken {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  tokenHash         String   @map("token_hash")
  expiresAt         DateTime @map("expires_at")
  revoked           Boolean  @default(false)
  replacedByTokenId String?  @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replaces   RefreshToken[] @relation("TokenRotation")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// NOTE: notificationPreferences column intentionally omitted.
// Deferred as a future improvement — to be added when the notification
// preference enforcement feature is fully implemented across the platform.
// See: BACKEND_COMPLETE.md → "Known Limitations and Future Improvements"
model PatientProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  userName           String?  @map("user_name")
  bio                String?
  timezone           String   @default("UTC")
  languagePreference String   @default("en") @map("language_preference")
  fcmToken           String?  @map("fcm_token")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

// NOTE: notificationPreferences column intentionally omitted.
// Deferred as a future improvement — to be added when the notification
// preference enforcement feature is fully implemented across the platform.
// See: BACKEND_COMPLETE.md → "Known Limitations and Future Improvements"
model TherapistProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  userName            String?  @map("user_name")
  bio                 String?
  timezone            String   @default("UTC")
  languagePreference  String   @default("en") @map("language_preference")
  specialisation      String?
  languages           String[] @default([])
  isAcceptingPatients Boolean  @default(true) @map("is_accepting_patients")
  fcmToken            String?  @map("fcm_token")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAcceptingPatients])
  @@index([specialisation])
  @@map("therapist_profiles")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  therapistId        String            @map("therapist_id") @db.Uuid
  slotStart          DateTime          @map("slot_start")
  slotEnd            DateTime          @map("slot_end")
  sessionType        SessionType       @map("session_type")
  status             AppointmentStatus @default(PENDING)
  cancellationReason String?           @map("cancellation_reason")
  rating             Int?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  patient   User @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  therapist User @relation("TherapistAppointments", fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, slotStart])
  @@index([patientId])
  @@index([therapistId, status, slotStart])
  @@map("appointments")
}

model MoodEntry {
  id                   String   @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  moodScore            Int      @map("mood_score")
  emotions             String[] @default([])
  sleepHours           Float?   @map("sleep_hours")
  stressLevel          Int?     @map("stress_level")
  energyLevel          Int?     @map("energy_level")
  journalNoteEncrypted String?  @map("journal_note_encrypted")
  triggers             String[] @default([])
  recordedAt           DateTime @default(now()) @map("recorded_at")
  createdAt            DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([id, recordedAt])
  @@index([userId, recordedAt])
  @@map("mood_entries")
}
