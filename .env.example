# Mindora V3 — copy to .env and adjust as needed.
# Requires Node.js 24+ (see .nvmrc).

# PostgreSQL (docker-compose)
DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora

# Transactional email provider (Resend). Verify the sender domain in production.
RESEND_EMAIL_API_KEY=
RESEND_FROM_EMAIL=Mindora <no-reply@mindora.rw>

# Notification Service — owns its own database (delivery log), not the shared 'mindora' DB.
NOTIFICATION_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_notifications

# Auth Service dedicated database
AUTH_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_auth

# User Service dedicated database
USER_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_user

# Appointment Service dedicated database
APPOINTMENT_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_appointment

# Mood Tracking Service dedicated database
MOOD_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_mood

# Docs Gateway — single Swagger UI aggregating every service's OpenAPI spec.
# Only used by the "bundle" deploy (Dockerfile.bundle + ecosystem.config.cjs),
# where all services run as sibling processes in one container.
DOCS_GATEWAY_PORT=3010

# Admin Service dedicated database
ADMIN_SERVICE_PORT=3009
ADMIN_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_admin

# AI Integration Service dedicated database
AI_SERVICE_PORT=3007
AI_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_ai

# External Therapy Chatbot API — the actual AI provider behind POST /chat.
# ai-integration-service exchanges each patient's id/email for a short-lived
# access token via POST /integration/session (server-to-server, see
# src/chatbotClient.ts) and caches it per patient in the chatbot_accounts
# table. This replaced the vendor's old per-patient signup/login flow.
# Set this to the actual private Railway URL of the Python chatbot service.
THERAPY_CHATBOT_BASE_URL=

# Shared secret proving ai-integration-service (not a stranger) is the one
# calling POST /integration/session. Server-side only — never sent to a
# browser, never committed. Get the real value from the chatbot vendor via a
# password manager, not this file.
MINDORA_INTEGRATION_KEY=

# Encrypts ai_interactions.user_message/ai_response (AES-256-GCM, application-layer).
AI_INTERACTION_ENCRYPTION_KEY=mindora-dev-ai-interaction-key-32bytes!!

# MongoDB (community-service, Sprint 1)
MONGODB_URI=mongodb://localhost:27017/mindora

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://mindora:mindora@localhost:5672

# Mood service — journal note encryption (AES-256-GCM)
MOOD_JOURNAL_ENCRYPTION_KEY=mindora-dev-mood-journal-key-32bytes!!
# Dedicated 32+ character secret used to AES-256-GCM encrypt therapist care-plan drafts.
THERAPIST_CARE_PLAN_ENCRYPTION_KEY=

# Auth / Kong JWT (use same secret in Kong and auth-service)
# Must match infrastructure/kong/kong.yml jwt_secrets.secret for local dev
JWT_SECRET=mindora-dev-jwt-secret-change-in-production

# Auth service
APP_BASE_URL=http://localhost:3000
# Production: set APP_BASE_URL=https://app.mindora.rw (used in password-reset email links)
# Parent domain for the refreshToken cookie when frontend and API are on
# different subdomains — production: COOKIE_DOMAIN=.mindora.rw (otherwise the
# frontend never sees the session and login loops back to /login). Leave
# empty for localhost.
COOKIE_DOMAIN=

# User service — called directly (service-to-service) by notification-service etc.
USER_SERVICE_URL=http://localhost:3002

# User service — S3-compatible object storage for therapist application
# documents (credential PDFs/images). Works against AWS S3 (leave endpoint
# unset) or any S3-compatible provider (Cloudflare R2, Backblaze B2, etc —
# set endpoint). Without these, document upload/download 500s; everything
# else in the therapist application system works fine without them.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Kong gateway URL — used for internal service-to-service calls that need
# gateway-enforced auth/rate-limiting (e.g. community-service -> user-service)
KONG_URL=http://localhost:8000

# Non-expiring service JWT for internal service-to-service calls.
# Generated by: npm run generate:service-token --workspace=@mindora/auth-service
# PRODUCTION TODO: replace with rotating credentials via AWS Secrets Manager.
# If compromised: regenerate token, update all services that use it, redeploy.
INTERNAL_SERVICE_TOKEN=

# Browser-generated FCM device token for local push testing (front-end-test-files/fcm-test.html).
# Not read by any service code — reference only, for reseeding patient_profiles.fcm_token in dev.
FCM_TEST_DEVICE_TOKEN=

# Africa's Talking credentials. Rotate any key that has ever appeared in chat/logs.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# SMS delivery via Africa's Talking. Set to 'true' only after account and recipient verification.
SMS_ENABLED=false

# Africa's Talking Voice notifications (must be explicitly enabled after the
# account has an approved Rwanda Voice number and a test call has been verified).
AT_VOICE_ENABLED=false
AT_VOICE_NUMBER=
AT_VOICE_WEBHOOK_TOKEN=
# Configure the issued Voice number in Africa's Talking dashboard to call these public HTTPS URLs.
# Add ?token=<AT_VOICE_WEBHOOK_TOKEN> to each URL if the provider portal supports query strings.
AT_VOICE_CALLBACK_URL=https://api.example.com/webhooks/voice/callback
AT_VOICE_EVENTS_URL=https://api.example.com/webhooks/voice/events
MINDORA_CRISIS_ALERT_VOICE_PHONES=
MINDORA_CRISIS_VOICE_SCRIPT=This is an automated MINDORA operations alert. A safety event requires your attention. Please access the secure MINDORA administration console and follow the approved escalation procedure.

# Google OAuth (optional — required for OAuth flow testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/oauth/google/callback
# Where the browser lands after GET /oauth/google/callback issues the session
# (frontend route, not this API) — see auth.routes.ts for why this must be a
# redirect target, not a JSON response.
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/oauth/success

# Platform-scale seed (npm run seed, scripts/seed-platform/) — generates an
# interconnected synthetic dataset (users -> profiles -> therapist
# applications -> therapists -> availability -> appointments ->
# notifications -> audit logs) across every database this build-out has
# touched, for local load/UI testing. Refuses to run against a non-localhost
# database unless SEED_CONFIRM_NON_LOCAL=yes-i-am-sure is set — this is
# dev/staging tooling, never something that should run against production
# data by accident.
TOTAL_USERS=10000
# Remaining users after ADMIN_COUNT split: THERAPIST_RATIO become approved
# therapists, ~5% get a non-approved application in flight (populates the
# admin review queue), the rest are plain patients.
PATIENT_RATIO=0.85
THERAPIST_RATIO=0.1
ADMIN_COUNT=5
# Set to any integer to make the generated dataset reproducible
# (SEED=12345 npm run seed always produces the exact same data). Omit for a
# fresh random dataset each run — the actual seed used is printed either way,
# so a run can always be reproduced after the fact.
SEED=
# One shared password for every seeded account — never a real login,
# documented and printed at the end of the seed run.
SEED_PASSWORD=Seeded-User-Not-A-Real-Login-1!
SEED_CONFIRM_NON_LOCAL=

# Restricted staff recipients; comma-separated. Configure before production.
MINDORA_BOOKING_ALERT_EMAILS=

# Restricted staff recipients; comma-separated. Configure before production.
MINDORA_BOOKING_ALERT_PHONES=

# Restricted staff recipients; comma-separated. Configure before production.
MINDORA_CRISIS_ALERT_EMAILS=

# Restricted staff recipients; comma-separated. Configure before production.
MINDORA_CRISIS_ALERT_PHONES=

# Private service-to-service webhook from the MINDORA Python conversation-therapy module.
# Generate a unique high-entropy secret and set the same value in the chatbot's backend .env.
CHATBOT_CRISIS_WEBHOOK_TOKEN=

# Clinical contacts must remain disabled until approved in writing by MINDORA's clinical lead.
CRISIS_CONTACTS_APPROVED=false
CRISIS_APPROVED_RESOURCES=
CRISIS_APPROVED_THERAPIST_ROUTE=
