# Mindora V3 — copy to .env and adjust as needed.
# Requires Node.js 24+ (see .nvmrc).

# PostgreSQL (docker-compose)
DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora

# Notification Service — owns its own database (delivery log), not the shared 'mindora' DB.
NOTIFICATION_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_notifications

# Auth Service dedicated database
AUTH_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_auth

# User Service dedicated database
USER_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_user

# Appointment Service dedicated database
APPOINTMENT_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_appointment

# Mood Tracking Service dedicated database
MOOD_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_mood

# Docs Gateway — single Swagger UI aggregating every service's OpenAPI spec.
# Only used by the "bundle" deploy (Dockerfile.bundle + ecosystem.config.cjs),
# where all services run as sibling processes in one container.
DOCS_GATEWAY_PORT=3010

# Admin Service dedicated database
ADMIN_SERVICE_PORT=3009
ADMIN_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_admin

# AI Integration Service dedicated database
AI_SERVICE_PORT=3007
AI_DATABASE_URL=postgresql://mindora:mindora@localhost:5432/mindora_ai

# External Therapy Chatbot API — the actual AI provider behind POST /chat.
# Own signup/login + conversation model, separate from Mindora's own auth;
# ai-integration-service provisions one chatbot account per patient lazily
# (see src/chatbotClient.ts).
THERAPY_CHATBOT_BASE_URL=https://mindoraversiontwo-production.up.railway.app

# Encrypts ai_interactions.user_message/ai_response and the stored chatbot
# account password (AES-256-GCM, application-layer).
AI_INTERACTION_ENCRYPTION_KEY=mindora-dev-ai-interaction-key-32bytes!!

# MongoDB — community-service and messaging-service.
#
# NOTE the name: both services read MONGO_URI (see community-service and
# messaging-service src/database.ts). MONGODB_URI below is a different variable
# read by exactly one thing, apps/messaging-service/scripts/backfill-encrypt.ts,
# and this file previously documented only that spelling — so following it left
# both services silently on their localhost fallback.
#
# Set MONGO_URI. Set MONGODB_URI too if you intend to run the backfill script,
# and keep the two pointed at the same database until the script is corrected
# to read MONGO_URI.
MONGO_URI=mongodb://localhost:27017/mindora
MONGODB_URI=mongodb://localhost:27017/mindora

# Community service — post/comment body encryption (AES-256-GCM), same pattern
# as the mood journal and chat message keys above.
COMMUNITY_ENCRYPTION_KEY=mindora-dev-community-key-32bytes!!!

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://mindora:mindora@localhost:5672

# Mood service — journal note encryption (AES-256-GCM)
MOOD_JOURNAL_ENCRYPTION_KEY=mindora-dev-mood-journal-key-32bytes!!

# Messaging service — chat message + last-message-preview encryption
# (AES-256-GCM). Rows written before encryption was wired up are plaintext;
# decryption passes those through unchanged, so nothing looks broken either
# way. Backfill them with:
#   npm run backfill:encrypt -w @mindora/messaging-service
MESSAGE_ENCRYPTION_KEY=mindora-dev-message-key-32bytes!!

# Auth / Kong JWT (use same secret in Kong and auth-service)
# Must match infrastructure/kong/kong.yml jwt_secrets.secret for local dev
JWT_SECRET=mindora-dev-jwt-secret-change-in-production

# JWT `iss` claim. Every service verifies against this and Kong matches routes
# on it (key_claim_name: iss), so all of them must agree. Only change it if you
# change it everywhere at once.
JWT_ISSUER=mindora-auth

# Drives cookie Secure/SameSite in auth-service and the fail-fast checks on
# JWT_SECRET / MESSAGE_ENCRYPTION_KEY. Deployments MUST set this to
# 'production': that is what switches the refresh cookie to SameSite=None;
# Secure, without which a frontend on another domain cannot hold a session
# (POST /refresh arrives with no cookie and every reload logs the user out).
NODE_ENV=development

# Log verbosity for auth-service's structured logger. 'debug' additionally
# emits a line per /health request, which Kong polls every few seconds.
# One of: debug | info | warn | error.
LOG_LEVEL=info

# Messaging service CORS allowlist — comma-separated origins, no wildcard.
# Separate from Kong's KONG_CORS_ORIGINS because socket.io connects to the
# service directly rather than through the gateway.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth service
APP_BASE_URL=http://localhost:3001

# User service — called directly (service-to-service) by notification-service etc.
USER_SERVICE_URL=http://localhost:3002

# Kong gateway URL — used for internal service-to-service calls that need
# gateway-enforced auth/rate-limiting (e.g. community-service -> user-service)
KONG_URL=http://localhost:8000

# Non-expiring service JWT for internal service-to-service calls.
# Generated by: npm run generate:service-token --workspace=@mindora/auth-service
# PRODUCTION TODO: replace with rotating credentials via AWS Secrets Manager.
# If compromised: regenerate token, update all services that use it, redeploy.
INTERNAL_SERVICE_TOKEN=

# Browser-generated FCM device token for local push testing (front-end-test-files/fcm-test.html).
# Not read by any service code — reference only, for reseeding patient_profiles.fcm_token in dev.
FCM_TEST_DEVICE_TOKEN=

# Email delivery via Resend (notification-service). Unset means email delivery
# is skipped rather than failing — useful locally, silent in production, so set
# it wherever notifications actually need to arrive.
RESEND_EMAIL_API_KEY=

# Firebase Cloud Messaging credentials (notification-service push delivery).
# Supply ONE of the two:
#   FIREBASE_SERVICE_ACCOUNT_JSON — the service account JSON inline, for hosts
#     that only take env vars.
#   FIREBASE_SECRETS_DIR — directory holding the service account file, for
#     hosts with mounted secrets. Defaults to /etc/secrets.
# With neither set, push delivery is disabled and logged rather than throwing.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SECRETS_DIR=/etc/secrets

# SMS delivery via Africa's Talking. Set to 'true' to enable in production.
# Planned for Mindora V4 — disabled by default, so the credentials below are
# only read when SMS_ENABLED=true.
SMS_ENABLED=false
AT_API_KEY=
AT_USERNAME=

# Base URL written into seeded therapist photo URLs
# (npm run db:seed:profiles). Points at the gateway's public photos route, so
# change it when seeding an environment that is not reachable on localhost.
PHOTOS_BASE_URL=http://localhost:8000/api/v1/users/photos

# Google OAuth (optional — required for OAuth flow testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/oauth/google/callback
# Where the browser lands after GET /oauth/google/callback issues the session
# (frontend route, not this API) — see auth.routes.ts for why this must be a
# redirect target, not a JSON response.
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/oauth/success

# --- Tooling (not read by any service) ---------------------------------------

# `npm run smoke:gateway` — where to send the gateway routing checks, and how
# long to wait per request. Point GATEWAY_URL at a deployed Kong to verify a
# release's routing from CI.
GATEWAY_URL=http://localhost:8000
SMOKE_TIMEOUT_MS=10000

# Per-service HTTP port. Not set here: each service defaults in its own
# config.ts, and docker-compose / ecosystem.config.cjs set PORT per process.
# Listed only so the variable is not a surprise when you see it in the code.
